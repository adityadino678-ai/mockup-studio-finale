{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mockup-studio",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "rate_limit_kv",
      "preview_id": "rate_limit_kv_preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
