# Mockup Studio - secret names only. No values.
#
# Copy this file to `.env` / `.dev.vars` (both git-ignored) and fill in only the
# secrets you need. Every key is optional: the core workflow works without any
# of them, and the UI reports an honest "not configured" state for the ones
# you leave empty.
#
# For the deployed Worker, do NOT put secrets here, and do not put a Printify
# key in Wrangler either. The public Worker intentionally has no Printify/AI
# key: every visitor pastes their own in Settings -> API connections, where it
# stays in their browser's IndexedDB. Server-side keys are only a fallback for a
# self-hosted/preview deployment (`npx wrangler secret put AI_API_KEY`).
# Secrets never ship inside `dist/`.
#
# CI reads secrets from repository/environment secrets, never from this file.
# Do NOT commit real values.

# Printify (https://developers.printify.com/)
PRINTIFY_API_KEY=

# Etsy (https://www.etsy.com/developers/)
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# AI provider (any OpenAI-compatible endpoint)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=

# Supabase Auth (optional; the local tools stay login-free)
# URL + anon key enable accounts. The anon key is a publishable key, but it is
# used only server-side; the browser calls /api/auth/*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. When set, /api/auth/signup creates an already-confirmed account and
# sends no mail. Without it, Supabase mails a confirmation link (the built-in
# sender is rate-limited until a sending domain exists).
SUPABASE_SERVICE_ROLE=

# Email (optional). Resend only sends once a verified domain exists; until then
# Supabase Auth sends its own verification/reset mail.
RESEND_API_KEY=
RESEND_FROM=

# Billing (optional). Pricing is PLACEHOLDER, so live mode stays off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The real public origin, e.g. https://listbulkly.com. Optional and build-time.
# When unset, app pages emit no canonical/og:url at all. A *.workers.dev host is
# rejected on purpose (see src/lib/site.ts).
PUBLIC_SITE_URL=
