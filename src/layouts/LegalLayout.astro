---
/**
 * Shell for the public legal pages (privacy, terms, refunds, cookies, contact).
 *
 * These pages are deliberately plain: one column of readable prose on paper,
 * the same nav/footer as the rest of the site, and a visible DRAFT line. The
 * legal text is real in so far as it describes what the code actually does;
 * every fact that needs a company registration, an address or a working inbox
 * is marked PLACEHOLDER and must be filled before launch.
 */
import SketchLayout from "@/layouts/SketchLayout.astro";
import { SketchNav } from "@/components/sketch/nav";
import { SketchFooter } from "@/components/sketch/footer";

interface Props {
  title: string;
  description: string;
  /** The date line. Kept honest: this is a draft until legal review. */
  updated?: string;
}

const { title, description, updated = "Draft — not in force yet" } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/printify-studio", label: "Studio" },
  { href: "/mockups", label: "Mockups" },
];

const legalLinks = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/refunds", label: "Refunds" },
  { href: "/cookies", label: "Cookies" },
  { href: "/contact", label: "Contact" },
];
---

<SketchLayout title={`${title} — ListBulkly`} description={description}>
  <SketchNav
    links={navLinks}
    loginHref={null}
    signupHref="/printify-studio"
    signupLabel="Open the Studio"
  />

  <main class="sk-container sk-section legal">
    <span class="sk-cap">ListBulkly · Legal</span>
    <h1 class="sk-part-title">{title}</h1>
    <p class="legal__meta">{updated}</p>
    <p class="sk-note">{description}</p>
    <div class="sk-stack legal__body">
      <slot />
    </div>
  </main>

  <SketchFooter links={legalLinks} />
</SketchLayout>

<style>
  .legal {
    max-width: 54rem;
    margin-inline: auto;
  }

  .legal__meta {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.65;
  }

  .legal__body :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .legal__body :global(h3) {
    margin-top: var(--space-6);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-caption);
  }

  .legal__body :global(p) {
    margin: 0;
    color: var(--ink);
    line-height: var(--leading-body);
  }

  .legal__body :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal__body :global(li) {
    position: relative;
    margin: var(--space-2) 0;
    padding-left: 1.35rem;
    line-height: var(--leading-body);
  }

  .legal__body :global(li)::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--orange);
  }

  .legal__body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal__body :global(strong) {
    font-weight: var(--weight-bold);
  }

  .legal__body :global(code) {
    font-size: 0.92em;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding: 0.05em 0.3em;
  }
</style>
