---
import "@fontsource-variable/josefin-sans";
import "@fontsource-variable/caveat";
import "@/styles/tokens.css";
import "@/styles/sketch.css";
import { SketchDefs, Grain } from "@/components/sketch";
import { BRAND } from "@/config/brand";
import { absoluteUrl } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Optional explicit canonical. Omitted until a custom domain exists. */
  canonical?: string;
}

const { title, description, noindex = false, canonical: explicitCanonical } = Astro.props;

// An explicit full URL always wins. Otherwise the canonical is derived from the
// opted-in PUBLIC_SITE_URL, and never for a noindex page. With no site URL
// configured this stays undefined, so no canonical and no og:url are emitted.
const canonical =
  explicitCanonical?.trim() || (noindex ? undefined : (absoluteUrl(Astro.url.pathname) ?? undefined));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={BRAND.paper} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="sketch-page">
    <SketchDefs />
    <Grain />
    <slot />
  </body>
</html>
