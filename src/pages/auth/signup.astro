---
import { PageHeader } from "@/components/layout/page-header";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Label } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { UserPlus } from "lucide-react";
---

<main class="mx-auto max-w-md p-8">
  <PageHeader
    title="Create account"
    description="Join Mockup Studio. Sign up with email to sync your designs, mockups, and listings to Supabase."
  />

  <Card className="mt-6">
    <CardHeader>
      <CardTitle className="flex items-center gap-2">
        <UserPlus className="h-4 w-4 text-forest" /> Create account
      </CardTitle>
    </CardHeader>
    <CardContent className="space-y-3">
      <form id="signup-form" class="space-y-3">
        <div class="space-y-1.5">
          <Label htmlFor="email">Email</Label>
          <input
            id="email"
            type="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            class="flex h-9 w-full rounded-md border border-border-strong bg-surface px-3 py-1 text-sm text-ink shadow-subtle transition-colors focus-visible:border-forest focus-visible:outline-none"
          />
        </div>
        <div class="space-y-1.5">
          <Label htmlFor="password">Password</Label>
          <input
            id="password"
            type="password"
            required
            minlength={8}
            autocomplete="new-password"
            class="flex h-9 w-full rounded-md border border-border-strong bg-surface px-3 py-1 text-sm text-ink shadow-subtle transition-colors focus-visible:border-forest focus-visible:outline-none"
          />
        </div>
        <div class="space-y-1.5">
          <Label htmlFor="fullName">Full name (optional)</Label>
          <input
            id="fullName"
            type="text"
            placeholder="Your name"
            autocomplete="name"
            class="flex h-9 w-full rounded-md border border-border-strong bg-surface px-3 py-1 text-sm text-ink shadow-subtle transition-colors focus-visible:border-forest focus-visible:outline-none"
          />
        </div>
        <Button type="submit" className="w-full flex items-center justify-center gap-2">
          <UserPlus className="h-4 w-4" /> Create account
        </Button>
      </form>
      <p id="signup-message" class="text-[12px] text-ink-muted text-center"></p>
    </CardContent>
  </Card>

  <p class="mt-6 text-[13px] text-ink-muted text-center">
    Already have an account?{" "}
    <a href="/auth/signin" class="text-forest underline font-medium">
      Sign in &rarr;
    </a>
  </p>
  <script src="/auth-forms.js" is:inline></script>
</main>
