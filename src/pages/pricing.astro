---
/**
 * /pricing — the real plans.
 *
 * The page is static: the four plan rows render on the server (the sk-plan
 * rows from the sketchbook system), and each paid plan's button is a small
 * client island (BillingButton) that handles sign-in, the live-rate note and
 * the Razorpay checkout. The free plan's button is a plain link into the
 * Studio — the tools stay login-free.
 *
 * Prices are set in USD and billed in the user's currency at the day's live
 * exchange rate, so the page never promises a fixed INR amount — it shows
 * "≈ ₹… at today's rate" as an estimate.
 */
import SketchLayout from "@/layouts/SketchLayout.astro";
import { SketchNav } from "@/components/sketch/nav";
import { SketchFooter } from "@/components/sketch/footer";
import { BillingButton } from "@/components/billing/billing-button";
import { PLANS, type PlanDef } from "@/lib/billing/plans";

const title = "Pricing — ListBulkly";
const description =
  "Free for 5 listings a month. $10 for 150, $20 for 250, $30 for 400 — billed monthly in your currency at the day's exchange rate.";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/printify-studio", label: "Studio" },
  { href: "/mockups", label: "Mockups" },
];

const footerLinks = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/refunds", label: "Refunds" },
  { href: "/cookies", label: "Cookies" },
  { href: "/contact", label: "Contact" },
];

const features: Record<string, string[]> = {
  free: [
    "5 listings a month",
    "The full workflow — designs, mockups, copy, background removal",
    "Bring your own Printify key",
    "No card, no sign-up to design",
  ],
  starter: [
    "150 listings a month",
    "Everything in Free, at volume",
    "Bulk copy, ink variants, ZIP exports",
    "Email support",
  ],
  pro: [
    "250 listings a month",
    "Everything in Starter",
    "Priority background-removal renders",
    "Email support",
  ],
  business: [
    "400 listings a month",
    "Everything in Pro",
    "Highest volume for catalogues",
    "Email support",
  ],
};
---

<SketchLayout title={title} description={description}>
  <SketchNav links={navLinks} />

  <main class="sk-container sk-section pricing">
    <span class="sk-cap">ListBulkly · Pricing</span>
    <h1 class="sk-part-title">Pick your volume</h1>
    <p class="sk-note">
      A listing is one Printify product created through ListBulkly. Every plan uses
      the whole workflow — designs, mockups, placement, copy, exports. Prices are
      in dollars, billed monthly; the checkout shows the exact amount in your
      currency before you confirm.
    </p>

    <div class="sk-stack">
      {
        (Object.values(PLANS) as PlanDef[]).map((plan) => (
          <section class="sk-plan">
            <h3>
              {plan.label}
              <span> ${plan.usd}/mo</span>
            </h3>
            <ul>
              {features[plan.id].map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            <div>
              {plan.id === "free" ? (
                <div class="billing-button">
                  <a class="sk-btn" href="/printify-studio">Start free</a>
                  <span class="billing-button__note">No card. No sign-up to design.</span>
                </div>
              ) : (
                <BillingButton
                  planId={plan.id}
                  label={`Choose ${plan.label}`}
                  client:load
                />
              )}
            </div>
          </section>
        ))
      }
    </div>

    <h2 class="pricing__sub">Questions</h2>
    <div class="sk-stack">
      <details class="sk-faq">
        <summary>What exactly is a "listing"?</summary>
        <p>
          One product created on Printify through ListBulkly — the moment your design
          becomes a draft product. Updating that product's copy, images or price later
          does not count again, and publishing is included.
        </p>
      </details>
      <details class="sk-faq">
        <summary>I pay in rupees — what will it cost?</summary>
        <p>
          The dollar price is the base ($10 / $20 / $30 a month). At checkout the
          exact amount is shown in your currency before you confirm — no surprises,
          and nothing is charged until you approve it.
        </p>
      </details>
      <details class="sk-faq">
        <summary>Do I need a subscription to try it?</summary>
        <p>
          No. The Free plan gives 5 listings a month, forever, with the full workflow.
          You only pay when your catalogue outgrows that.
        </p>
      </details>
      <details class="sk-faq">
        <summary>How do I cancel or change plans?</summary>
        <p>
          Email <a href="mailto:listbulkly@gmail.com">listbulkly@gmail.com</a> with
          "billing" in the subject, or use the contact page. You keep your plan until
          the end of the month you paid for. The terms and the refund rules are on
          the <a href="/refunds">Refunds</a> and <a href="/terms">Terms</a> pages.
        </p>
      </details>
      <details class="sk-faq">
        <summary>Does ListBulkly charge Printify or Etsy fees?</summary>
        <p>
          No. ListBulkly is independent and not affiliated with Printify or Etsy.
          They bill you directly for what you use on their platforms — Etsy charges
          $0.20 per listing published.
        </p>
      </details>
      <details class="sk-faq">
        <summary>What happens if I hit my cap?</summary>
        <p>
          Creation stops politely: the app tells you how many listings you have used
          and links here. Everything else — editing, mockups, exports — keeps
          working. The count resets on the 1st of the month (UTC).
        </p>
      </details>
    </div>
  </main>

  <SketchFooter links={footerLinks} />
</SketchLayout>

<style>
  .pricing {
    max-width: 56rem;
    margin-inline: auto;
  }

  .pricing__sub {
    margin-top: var(--space-10);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .billing-button {
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .billing-button :global(.sk-btn) {
    min-width: 11rem;
    text-align: center;
  }

  .billing-button__note {
    font-size: var(--text-sm);
    color: var(--ink);
    opacity: 0.65;
  }

  .billing-button__message {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--blue);
    max-width: 22rem;
  }
</style>
