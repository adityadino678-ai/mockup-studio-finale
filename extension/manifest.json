{
  "manifest_version": 3,
  "name": "Mockup Studio Printify Bridge",
  "version": "1.1.0",
  "description": "Applies the mockup images Mockup Studio prepared to a Printify product, and reads public Etsy search results, inside your own signed-in browser.",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://printify.com/*",
    "https://*.printify.com/*",
    "https://etsy.com/*",
    "https://*.etsy.com/*",
    "https://mockup-studio.adityadino678.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mockup-studio.adityadino678.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["payload-guard.js", "content-app.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Mockup Studio Printify Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
